# 数据库迁移测试配置文件
# Database Migration Test Configuration

# ==============================================
# SQLite 配置 (SQLite Configuration)
# ==============================================

# 数据库类型 - 设置为 sqlite 以使用 SQLite
DB_TYPE=sqlite

# SQLite 数据库文件目录
DB_DIR=./test_data

# ==============================================
# PostgreSQL 配置 (PostgreSQL Configuration)
# ==============================================

# 要使用 PostgreSQL 进行测试，取消注释以下行并设置适当的值
# To use PostgreSQL for testing, uncomment the lines below and set appropriate values

# 数据库类型 - 设置为 postgresql 以使用 PostgreSQL
# DB_TYPE=postgresql

# PostgreSQL 连接参数
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_NAME=usdtmore_test
# DB_SSLMODE=disable
# DB_TIMEZONE=Asia/Shanghai

# 或者使用完整的 DSN 字符串
# POSTGRESQL_DSN=host=localhost port=5432 user=postgres password=your_password dbname=usdtmore_test sslmode=disable TimeZone=Asia/Shanghai

# ==============================================
# 测试专用配置 (Test-specific Configuration)  
# ==============================================

# 数据库调试模式（显示SQL语句）
DB_DEBUG=true

# 连接池配置
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# 连接超时配置
DB_CONNECT_TIMEOUT=10

# 应用程序名称
DB_APP_NAME=usdtmore_test

# ==============================================
# 性能测试配置 (Performance Test Configuration)
# ==============================================

# 性能测试参数（可根据硬件调整）
PERF_TEST_BATCH_SIZE=1000
PERF_TEST_CONCURRENT_WORKERS=10
PERF_TEST_OPS_PER_WORKER=50

# ==============================================
# 迁移测试配置 (Migration Test Configuration)
# ==============================================

# 测试数据量
MIGRATION_TEST_WALLET_COUNT=100
MIGRATION_TEST_ORDER_COUNT=200
MIGRATION_TEST_NOTIFY_COUNT=50

# ==============================================
# 日志配置 (Logging Configuration)
# ==============================================

# 日志级别
LOG_LEVEL=INFO

# 日志目录
LOG_DIR=./test_logs

# ==============================================
# 临时文件配置 (Temporary Files Configuration)
# ==============================================

# 临时文件目录
TEMP_DIR=/tmp/usdtmore_tests

# ==============================================
# 测试环境标识 (Test Environment Identification)
# ==============================================

# 测试环境标识
TEST_ENV=true
TEST_MODE=database_migration

# ==============================================
# Docker 测试配置 (Docker Test Configuration)
# ==============================================

# PostgreSQL Docker 配置（用于CI/CD环境）
# DOCKER_POSTGRES_IMAGE=postgres:15
# DOCKER_POSTGRES_DB=usdtmore_test
# DOCKER_POSTGRES_USER=test_user
# DOCKER_POSTGRES_PASSWORD=test_password
# DOCKER_POSTGRES_PORT=5432

# ==============================================
# 示例完整配置 (Example Complete Configuration)
# ==============================================

# 以下是 PostgreSQL 的完整测试配置示例：
# Uncomment and modify for your PostgreSQL test environment:

# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=usdtmore_test
# DB_PASSWORD=test123456
# DB_NAME=usdtmore_test
# DB_SSLMODE=disable
# DB_TIMEZONE=Asia/Shanghai
# DB_DEBUG=true
# DB_MAX_IDLE_CONNS=10
# DB_MAX_OPEN_CONNS=50
# DB_CONN_MAX_LIFETIME=5m
# DB_CONN_MAX_IDLE_TIME=1m

# ==============================================
# 注意事项 (Important Notes)
# ==============================================

# 1. 测试会创建和删除临时数据，请不要在生产数据库上运行
#    Tests will create and delete temporary data, do not run on production database
#
# 2. PostgreSQL 测试需要预先创建测试数据库
#    PostgreSQL tests require the test database to be created beforehand
#
# 3. 确保测试用户有足够的权限创建、删除表
#    Ensure the test user has sufficient privileges to create and drop tables
#
# 4. SQLite 测试文件会在测试后自动清理
#    SQLite test files are automatically cleaned up after tests
#
# 5. 性能测试可能需要较长时间，可以通过调整参数来控制
#    Performance tests may take a long time, adjust parameters to control duration