# 测试环境 Dockerfile
# Dockerfile for testing environment

FROM golang:1.23-alpine AS builder

# 安装必要的系统依赖
RUN apk add --no-cache \
    git \
    gcc \
    musl-dev \
    sqlite \
    postgresql-client \
    curl \
    bash \
    make

# 设置工作目录
WORKDIR /app

# 复制 go mod 文件
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 构建测试工具
RUN go build -o bin/db-connection-test ./tests/db_connection_test.go
RUN go build -o bin/db-migration-test ./tests/db_migration_test.go  
RUN go build -o bin/db-performance-test ./tests/db_performance_test.go
RUN go build -o bin/db-operations-test ./tests/db_operations_test.go

# 创建最终镜像
FROM alpine:latest

# 安装运行时依赖
RUN apk add --no-cache \
    ca-certificates \
    sqlite \
    postgresql-client \
    bash \
    curl \
    && rm -rf /var/cache/apk/*

# 创建应用目录
WORKDIR /app

# 从构建器阶段复制文件
COPY --from=builder /app/bin/ ./bin/
COPY --from=builder /app/tests/ ./tests/

# 创建测试数据目录
RUN mkdir -p test_data test_logs

# 复制测试脚本
COPY tests/run_tests.sh ./
RUN chmod +x run_tests.sh

# 设置环境变量
ENV PATH="/app/bin:${PATH}"
ENV TEST_ENV=true

# 暴露测试相关端口（如果需要）
EXPOSE 8080

# 默认命令
CMD ["./run_tests.sh"]