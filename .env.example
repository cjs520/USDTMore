# USDTMore 环境变量配置示例
# 复制此文件为 .env 并修改相应配置

# ===========================================
# 数据库配置 (PostgreSQL Only)
# ===========================================

# 数据库类型: 只支持 postgresql
DB_TYPE=postgresql

# PostgreSQL 连接配置 (必需)
DB_HOST=postgres
DB_PORT=5432
DB_USER=usdtmore_user
DB_PASSWORD=your_secure_password_here
DB_NAME=usdtmore
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# 或者使用完整DSN (优先级高于单独配置)
# POSTGRESQL_DSN=host=postgres port=5432 user=usdtmore_user password=your_secure_password_here dbname=usdtmore sslmode=disable TimeZone=UTC

# 数据库连接池配置
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# 数据库调试模式 (true/false)
DB_DEBUG=false

# ===========================================
# 应用基础配置
# ===========================================

# 服务监听地址
LISTEN=:6080

# 授权Token
AUTH_TOKEN=your_auth_token_here

# 应用URI (用于生成回调地址)
APP_URI=https://your-domain.com

# 是否重写HTTPS (反向代理时使用)
REWRITE_HTTPS=false

# 订单过期时间(秒)
EXPIRE_TIME=1800

# 支付金额范围 (最小,最大)
PAYMENT_AMOUNT_RANGE=0.01,99999

# ===========================================
# USDT汇率配置
# ===========================================

# USDT汇率设置
# 固定汇率: 7.4
# 动态汇率: =7.4 (无波动), +0.1 (上浮), -0.1 (下浮), ~0.1 (随机波动)
USDT_RATE=7.4

# ===========================================
# 区块链API配置
# ===========================================

# TRON 配置
TRON_SERVER_API=TRON_SCAN
TRON_SCAN_API_KEY=your_tronscan_api_key
TRON_GRID_API_KEY=your_trongrid_api_key

# EVM兼容链统一API Key (推荐使用)
ETHERSCAN_API_KEY=your_etherscan_api_key

# 旧版各链专用API Key (向后兼容)
# POLYGON_SCAN_API_KEY=your_polygon_api_key
# OPTIMISM_EXPLORER_API_KEY=your_optimism_api_key
# BSC_SCAN_API_KEY=your_bsc_api_key
# ARBITRUM_SCAN_API_KEY=your_arbitrum_api_key
# XLAYER_SCAN_API_KEY=your_xlayer_api_key

# 其他链配置
SOLANA_API_KEY=your_solana_api_key
APTOS_API_KEY=your_aptos_api_key

# 区块链确认设置
TRADE_IS_CONFIRMED=false
ETH_CONFIRMATION=50

# ===========================================
# 钱包地址配置
# ===========================================

# 初始钱包地址 (格式: CHAIN:ADDRESS,CHAIN:ADDRESS)
WALLET_ADDRESS=TRON:TYour1TronAddressHere,POLY:0xYourPolygonAddressHere,OP:0xYourOptimismAddressHere

# ===========================================
# Telegram Bot 配置
# ===========================================

# Telegram Bot Token
TG_BOT_TOKEN=your_bot_token_here

# 管理员用户ID
TG_BOT_ADMIN_ID=your_admin_user_id

# 通知群组ID
TG_BOT_GROUP_ID=your_group_id

# ===========================================
# 日志配置
# ===========================================

# 日志目录
LOG_DIR=/var/log/usdtmore

# HTML模板和静态文件目录
HTML_DIR=/path/to/html/templates

# ===========================================
# 备份和监控配置 (可选)
# ===========================================

# 备份保留天数
RETENTION_DAYS=30

# 云备份开关
CLOUD_BACKUP_ENABLED=false