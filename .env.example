# USDTMore 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# ===========================================
# 🔒 安全配置（必需）
# ===========================================

# 认证Token - 强烈建议设置32位以上强密钥
AUTH_TOKEN=your_32_char_secure_token_here_change_me

# ===========================================
# 🤖 Telegram Bot 配置（必需）
# ===========================================

# Telegram Bot Token（从 @BotFather 获取）
TG_BOT_TOKEN=6123456789:AAEhBOweik6ad6PsLMuhl3oifns_change_me

# Telegram Bot 管理员ID（发送 /start 给 @userinfobot 获取）
TG_BOT_ADMIN_ID=123456789

# ===========================================
# 🗄️ PostgreSQL 数据库配置
# ===========================================

# 数据库类型（仅支持PostgreSQL）
DB_TYPE=postgres

# 数据库连接信息
DB_HOST=localhost
DB_PORT=5432
DB_NAME=usdtmore
DB_USER=usdtmore
DB_PASSWORD=your_secure_db_password_change_me

# 数据库SSL模式（生产环境建议使用 require）
DB_SSLMODE=disable

# 数据库时区
DB_TIMEZONE=Asia/Shanghai

# ===========================================
# 🌐 应用服务配置
# ===========================================

# HTTP服务监听地址和端口
LISTEN=:6080

# 应用访问地址（建议设置，用于生成回调URL）
APP_URI=https://your-domain.com

# 重写HTTP为HTTPS（使用反向代理时启用）
REWRITE_HTTPS=false

# ===========================================
# 💰 交易配置
# ===========================================

# 订单有效期（秒，默认30分钟）
EXPIRE_TIME=1800

# USDT汇率（留空则自动获取OKX交易所汇率）
USDT_RATE=

# TRON网络是否需要确认（0=不需要，1=需要）
TRADE_IS_CONFIRMED=0

# ETH兼容网络需要确认的块数
ETH_CONFIRMATION=0

# 启动时需要添加的钱包地址（可选）
WALLET_ADDRESS=

# ===========================================
# 🔑 区块链API密钥配置（必需）
# ===========================================

# EVM链统一API密钥（支持 ETH、BSC、Polygon、Optimism、Arbitrum、X-Layer）
# 获取地址：https://etherscan.io/apis
ETHERSCAN_API_KEY=ABCD1234EFGH5678_change_me
ETHERSCAN_API_KEY_2=EFGH5678ABCD1234_change_me  # 可选，用于API轮询
ETHERSCAN_API_KEY_3=5678ABCD1234EFGH_change_me  # 可选，用于API轮询

# ===========================================
# 🚀 BSC专用Web3 API配置（重要）
# ===========================================

# BSC Web3 API提供商选择（推荐使用专业API以避免限制）
# 可选值: MORALIS, QUICKNODE, ALCHEMY, ETHERSCAN
BSC_WEB3_PROVIDER=MORALIS

# BSC监控模式
# RECENT: 仅监控最新区块（推荐，性能更好）
# FULL: 完整历史记录监控（资源消耗大）
BSC_MONITOR_MODE=RECENT

# 最新区块监控范围（仅在RECENT模式下生效）
BSC_RECENT_BLOCK_RANGE=100

# Moralis Web3 API（推荐免费方案）
# 注册地址: https://moralis.io
MORALIS_API_KEY=your_moralis_api_key_here

# QuickNode API
# 注册地址: https://quicknode.com
QUICKNODE_API_KEY=your_quicknode_api_key_here
QUICKNODE_ENDPOINT=https://your-quicknode-endpoint.com

# Alchemy API
# 注册地址: https://alchemy.com
ALCHEMY_API_KEY=your_alchemy_api_key_here

# TRON Grid API密钥（必需）
# 获取地址：https://www.trongrid.io/
TRON_GRID_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# TRON Scan API密钥（可选，备用）
# 获取地址：https://tronscan.org/
TRON_SCAN_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# TRON服务器API类型（可选，默认使用TronGrid）
# 可选值：
# - TRON_GRID (使用TronGrid API，推荐)
# - TRON_SCAN (使用TronScan API)
TRON_SERVER_API=TRON_GRID

# Solana API密钥（可选）
# 获取地址：https://docs.solana.com/api
SOLANA_API_KEY=your_solana_api_key_here

# ===========================================
# 🔧 高级配置（可选）
# ===========================================

# 日志级别（debug, info, warn, error）
LOG_LEVEL=info

# 最大并发连接数
MAX_CONNECTIONS=100

# HTTP请求超时时间（秒）
HTTP_TIMEOUT=30

# 数据库连接池大小
DB_MAX_CONNECTIONS=10

# ===========================================
# 📝 配置说明
# ===========================================

# 1. 必需配置项：
#    - AUTH_TOKEN: 用于API认证的安全令牌
#    - TG_BOT_TOKEN: Telegram机器人令牌
#    - TG_BOT_ADMIN_ID: Telegram管理员ID
#    - ETHERSCAN_API_KEY: EVM链API密钥
#    - TRON_GRID_API_KEY: TRON链API密钥
#    - DB_PASSWORD: 数据库密码

# 2. 支持的区块链网络：
#    - TRON (TRC20-USDT)
#    - Polygon (ERC20-USDT)
#    - Optimism (ERC20-USDT)
#    - BSC (BEP20-USDT)
#    - Arbitrum One (ERC20-USDT)
#    - X-Layer (USDT)
#    - Solana (SPL-USDT)
#    - Aptos (USDT)

# 3. 安全建议：
#    - 使用强密码和随机令牌
#    - 生产环境启用HTTPS
#    - 定期更新API密钥
#    - 启用数据库SSL连接

# 4. 获取API密钥：
#    - Etherscan: https://etherscan.io/apis
#    - TRON Grid: https://www.trongrid.io/
#    - Telegram Bot: @BotFather
#    - 管理员ID: @userinfobot