# USDTMore 本地测试配置

# 数据库配置
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=usdtmore_user  
DB_PASSWORD=your_secure_password_here
DB_NAME=usdtmore
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# 数据库连接池配置
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# 应用配置
LISTEN=:8080
AUTH_TOKEN=test_auth_token_123
APP_URI=http://localhost:8080
REWRITE_HTTPS=false
EXPIRE_TIME=1800
PAYMENT_AMOUNT_RANGE=0.01,99999

# USDT汇率
USDT_RATE=7.4

# API配置 (测试用占位符)
ETHERSCAN_API_KEY=test_etherscan_key
TRON_SCAN_API_KEY=test_tronscan_key
SOLANA_API_KEY=test_solana_key

# 区块链设置
TRON_SERVER_API=TRON_SCAN
ETH_CONFIRMATION=0
TRADE_IS_CONFIRMED=0

# Telegram Bot (测试用占位符)
TG_BOT_TOKEN=test_bot_token
TG_BOT_ADMIN_ID=123456789
TG_BOT_GROUP_ID=123456789

# 钱包地址 (测试用占位符)
WALLET_ADDRESS=TRON:TTestTronAddressHere,BSC:0xTestBSCAddressHere

# 文件路径
HTML_DIR=./